# Default deny: all hidden files/dirs and markdown
.*
*.md

# Explicit includes
!.gitignore
!README.md
!.github/
!.github/workflows/
!.github/workflows/pages.yml

# Dependencies
/vendor/
/frontend/node_modules/

# Build artifacts
/frontend/.tanstack/
/public/dist/

# Locks (regenerated on install)
/frontend/bun.lock

# Logs
*.log
